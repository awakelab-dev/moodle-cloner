# SSH key used by this app server for remote operations
REMOTE_SSH_KEY=/home/ubuntu/.ssh/id_ed25519

# Destination DB admin access (used for DB/user creation and import,
# AND for storing this app's own users/sessions metadata).
TARGET_DB_HOST=aurora-moodle-cluster.cluster-xxxx.eu-west-3.rds.amazonaws.com
TARGET_DB_ADMIN_USER=admin_moodle
TARGET_DB_ADMIN_PASS=change_me

# Database name (on the Aurora cluster above) for this app's own metadata
# (users, sessions, permissions). Created automatically on first run.
APP_DB_NAME=moodle_cloner_app

# Initial superadmin seeded on first run if no users exist.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=change_me_on_first_login

# Optional: cookie signing / session secret. If empty, one is generated and
# persisted in the database on first run.
APP_SESSION_SECRET=
